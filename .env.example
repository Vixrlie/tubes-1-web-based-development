APP_ADDR=:8080
APP_ENV=development
PLATFORM_DB_URL=postgres://platform:platform@localhost:5432/platform?sslmode=disable
TEST_DB_URL=postgres://test:test@localhost:5434/test?sslmode=disable
# Target DB connections are registered by the Platform Admin through the app,
# e.g. postgres://target:target@localhost:5433/sample?sslmode=disable

# Cookie: true kalau diakses lewat HTTPS
COOKIE_SECURE=false

# Admin pertama (dibaca saat seed, jangan commit password asli)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session (nilai usulan, putuskan di README)
SESSION_IDLE_TIMEOUT=30m
SESSION_ABSOLUTE_TIMEOUT=8h
SESSION_ROTATE_INTERVAL=15m
SESSION_GRACE_PERIOD=30s